#!/usr/bin/env bash
#
# Zero-dependency secret scanner. Blocks a commit that introduces a likely
# secret in its STAGED changes (added lines only).
#
# Enable in a fresh clone:   git config core.hooksPath .githooks
# Bypass (rare, deliberate): git commit --no-verify
# Mark an intentional public value (e.g. an analytics id) so it's ignored:
#   add a trailing comment  ->  pragma: allowlist secret
#
set -uo pipefail

# High-confidence patterns for real keys/tokens — scanned in EVERY file.
high_confidence=(
  '-----BEGIN[A-Z ]*PRIVATE KEY-----'                 # PEM private keys
  'AKIA[0-9A-Z]{16}'                                  # AWS access key id
  'ASIA[0-9A-Z]{16}'                                  # AWS temp access key
  'sk-(ant-)?[A-Za-z0-9_-]{20,}'                      # OpenAI / Anthropic keys
  'gh[pousr]_[A-Za-z0-9]{30,}'                        # GitHub tokens
  'github_pat_[A-Za-z0-9_]{30,}'                      # GitHub fine-grained PAT
  'xox[baprs]-[A-Za-z0-9-]{10,}'                      # Slack tokens
  'AIza[0-9A-Za-z_-]{35}'                             # Google API key
  'sk_live_[0-9a-zA-Z]{20,}'                          # Stripe secret key
  'rk_live_[0-9a-zA-Z]{20,}'                          # Stripe restricted key
  '(postgres(ql)?|mysql|mongodb(\+srv)?|redis|amqp)://[^:@/[:space:]]+:[^@/[:space:]]+@'  # creds in a URL
)
# Generic "secret=..." assignments — noisy in test fixtures (dummy passwords),
# so these are skipped for test files but enforced everywhere else.
generic=(
  '(secret|password|passwd|client[_-]?secret|api[_-]?key|access[_-]?key|private[_-]?key|auth[_-]?token)["'"'"' ]*[:=][[:space:]]*["'"'"'][^"'"'"' ]{8,}'
)

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

found=0
report=""

while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Don't scan the scanner itself (its pattern list is full of secret-shaped
  # strings) or large generated lockfiles.
  case "$f" in
    .githooks/*|*.lock|*package-lock.json|*bun.lockb|*uv.lock) continue ;;
  esac
  # Build the pattern set for this file: test files only get high-confidence
  # patterns (dummy passwords in fixtures shouldn't block commits).
  patterns=( "${high_confidence[@]}" )
  case "$f" in
    *test_*.py|*_test.py|*/tests/*|*/tests_integration/*|*.test.ts|*.test.tsx|*.test.js|*/__tests__/*) ;;
    *) patterns+=( "${generic[@]}" ) ;;
  esac
  added=$(git diff --cached -U0 --no-color -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  [ -z "$added" ] && continue
  while IFS= read -r line; do
    case "$line" in
      *"pragma: allowlist secret"*|*"gitleaks:allow"*) continue ;;
    esac
    for p in "${patterns[@]}"; do
      if printf '%s' "$line" | grep -EqiI -e "$p"; then
        snippet=$(printf '%s' "$line" | sed 's/^+//' | cut -c1-80)
        report="${report}\n  ${f}: ${snippet}"
        found=1
        break
      fi
    done
  done <<< "$added"
done <<< "$files"

if [ "$found" -ne 0 ]; then
  printf '\n\033[31m✖ Possible secret detected in staged changes:\033[0m'
  printf '%b\n' "$report"
  cat <<'MSG'

Commit blocked by .githooks/pre-commit (secret scanner).
  • Real secret?  Remove it, use an env var / secret store, then re-commit.
  • Public id / false positive?  Append "pragma: allowlist secret" to the line,
    or bypass once with:  git commit --no-verify
MSG
  exit 1
fi
exit 0
